# Đổi tên file này thành .env (trong Terminal: mv env.example .env)
# rồi điền 2 API key. KHÔNG commit file .env.

# Lấy tại https://platform.deepseek.com (nạp tối thiểu ~$2 là thừa cho test)
DEEPSEEK_API_KEY=sk-...

# Lấy tại https://platform.openai.com (nạp tối thiểu $5)
OPENAI_API_KEY=sk-...

# Lấy tại https://aistudio.google.com → Get API key (có free tier)
GEMINI_API_KEY=AIza...

# ==== Tùy chọn — mặc định đã đúng, chỉ sửa khi cần ====
# DEEPSEEK_MODEL=deepseek-v4-flash
# OPENAI_MODEL=gpt-5-mini
# OPENAI_REASONING_EFFORT=low
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_REASONING_EFFORT=none   (để rỗng nếu API báo 400 không nhận tham số)
# SO_BAI=50
# Giá $/1M token (cập nhật nếu hãng đổi giá):
# GIA_DEEPSEEK_IN=0.14
# GIA_DEEPSEEK_OUT=0.28
# GIA_OPENAI_IN=0.25
# GIA_OPENAI_OUT=2.00
# GIA_GEMINI_IN=0.25
# GIA_GEMINI_OUT=1.50
